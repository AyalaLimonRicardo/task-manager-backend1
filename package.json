{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "API REST de gestión de tareas con Express y TypeScript.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
