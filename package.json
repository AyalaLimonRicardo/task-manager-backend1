{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "API REST de gestión de tareas con Express y TypeScript.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "client:check": "pnpm --filter task-manager-client check",
    "client:build": "pnpm --filter task-manager-client build",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm client:check && pnpm client:build",
    "build": "tsc",
    "start": "node dist/server.js",
    "role:set": "tsx src/scripts/set-user-role.ts"
  },
  "keywords": [
    "node",
    "typescript",
    "backend",
    "express",
    "api-rest"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mongoose": "8.24.7",
    "swagger-ui-express": "5.0.1"
  }
}
